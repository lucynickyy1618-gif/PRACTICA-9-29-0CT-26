#include <stdio.h>

int main() {
    int elem;
    do {
        printf("Dame un numero entero entre 1 y 10 para indicar la longitud del arreglo: ");
        scanf("%i", &elem);
    } while (elem < 1 || elem > 10);
    
    int lista[elem];
    for (int i = 0; i < elem; i++) {
        printf("Dame un numero para el elemento %i del arreglo: ", i);
        scanf("%i", &lista[i]);
    }
    printf("Los valores de la lista son: ");
    for (int j = 0; j < elem; j++) {
        printf("%i ", lista[j]);
    }
    printf("\n\n");
    return 0;
}
